<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#000000"
    android:gravity="center">

    <TextView
        android:text="SYSTEM SETUP"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="1. Storage Access"
        android:textColor="#AAAAAA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:text="Required to clean gallery instantly."
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/btn_grant_files"
        android:text="GRANT FILE ACCESS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF9800"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:text="2. Location Services"
        android:textColor="#AAAAAA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:text="Required for SOS Beacon coordinates."
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/btn_grant_location"
        android:text="GRANT GPS ACCESS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btn_finish_setup"
        android:text="ENTER SYSTEM"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#4CAF50"/>

</LinearLayout>
